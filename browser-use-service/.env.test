# Test LinkedIn Credentials
TEST_LINKEDIN_USERNAME=test_user@example.com
TEST_LINKEDIN_PASSWORD=test_password

# API Keys
ANTHROPIC_API_KEY=your_test_anthropic_key
OPENAI_API_KEY=your_test_openai_key

# Service Configuration
TEST_PORT=8002
TEST_HOST=localhost

# Performance Thresholds
MAX_LOGIN_DURATION_SEC=30
MAX_SEARCH_DURATION_SEC=15
MAX_PROFILE_ACTION_DURATION_SEC=10

# Test Metrics
ENABLE_PERFORMANCE_LOGGING=true
METRICS_COLLECTION_INTERVAL_SEC=1 